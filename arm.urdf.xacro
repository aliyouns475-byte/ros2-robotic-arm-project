<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

  <!-- Dimensions (meters) -->
  <xacro:property name="base_h" value="0.08"/>
  <xacro:property name="l1_len" value="0.12"/>
  <xacro:property name="l2_len" value="0.15"/>
  <xacro:property name="l3_len" value="0.09"/>
  <xacro:property name="ee_len" value="0.06"/>

  <!-- Materials -->
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1"/></material>
  <material name="green"><color rgba="0.2 0.7 0.3 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>

  <!-- Cylinder link: frame at its bottom, extends up along +Z -->
  <xacro:macro name="cyl_link" params="name length radius mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${length}" radius="${radius}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><cylinder length="${length}" radius="${radius}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(3*radius*radius+length*length)/12}" ixy="0" ixz="0"
                 iyy="${mass*(3*radius*radius+length*length)/12}" iyz="0"
                 izz="${mass*radius*radius/2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Revolute joint with servo-like limits -->
  <xacro:macro name="rev_joint" params="name parent child z axis">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="0 0 ${z}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="-1.57" upper="1.57" effort="2.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ros2_control interface for one joint -->
  <xacro:macro name="ctrl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Fixed to the world so the arm does not fall -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Links -->
  <xacro:cyl_link name="base_link" length="${base_h}" radius="0.05" mass="0.3" color="grey"/>
  <xacro:cyl_link name="L1" length="${l1_len}" radius="0.02" mass="0.1" color="blue"/>
  <xacro:cyl_link name="L2" length="${l2_len}" radius="0.018" mass="0.1" color="orange"/>
  <xacro:cyl_link name="L3" length="${l3_len}" radius="0.016" mass="0.08" color="green"/>
  <xacro:cyl_link name="end_effector" length="${ee_len}" radius="0.012" mass="0.05" color="red"/>

  <!-- Joints -->
  <xacro:rev_joint name="joint1" parent="base_link" child="L1" z="${base_h}" axis="0 0 1"/>
  <xacro:rev_joint name="joint2" parent="L1" child="L2" z="${l1_len}" axis="0 1 0"/>
  <xacro:rev_joint name="joint3" parent="L2" child="L3" z="${l2_len}" axis="0 1 0"/>
  <xacro:rev_joint name="joint4" parent="L3" child="end_effector" z="${l3_len}" axis="0 1 0"/>

  <!-- ros2_control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:ctrl_joint name="joint1"/>
    <xacro:ctrl_joint name="joint2"/>
    <xacro:ctrl_joint name="joint3"/>
    <xacro:ctrl_joint name="joint4"/>
  </ros2_control>

  <!-- Gazebo plugin that loads the controller manager -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_simulation)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
